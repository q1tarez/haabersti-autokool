<%- include("../partials/header", { title, hideStickyCta: true, currentPath: '/account' }) %>

<section class="account-heading">
  <div>
    <h1><%= copy.courses %></h1>
    <p class="section-lead"><%= username %> · <%= email %></p>
  </div>
  <div class="account-heading-actions">
    <a class="btn secondary" href="/account/login?admin=1"><%= copy.adminSignIn %></a>
    <form method="post" action="/account/logout">
      <button type="submit" class="btn secondary"><%= copy.logout %></button>
    </form>
  </div>
</section>

<% if (courses.length) { %>
  <section class="account-course-list" aria-label="<%= copy.courses %>">
    <% courses.forEach(function (course) { %>
      <article class="card account-course">
        <h2><%= course.course_name %></h2>
        <dl class="account-details">
          <div>
            <dt><%= copy.courseStatus %></dt>
            <dd><%= course.status === "contacted" ? copy.statusContacted : course.status === "closed" ? copy.statusClosed : copy.statusNew %></dd>
          </div>
          <div>
            <dt><%= copy.payment %></dt>
            <dd><%= course.payment_status === "paid" ? copy.paid : course.payment_status === "unpaid" ? copy.unpaid : copy.pendingPayment %></dd>
          </div>
          <div>
            <dt><%= copy.instructor %></dt>
            <dd><%= course.instructorName || copy.unknown %></dd>
          </div>
          <div>
            <dt><%= copy.courseDate %></dt>
            <dd><%= course.start_date || copy.unknown %></dd>
          </div>
          <div>
            <dt><%= copy.preferredTime %></dt>
            <dd><%= course.preferredTime || copy.unknown %></dd>
          </div>
        </dl>
      </article>
    <% }); %>
  </section>
<% } else { %>
  <p class="card account-empty"><%= copy.noCourses %></p>
<% } %>

<section class="card account-notifications">
  <h2><%= copy.notifications %></h2>
  <% if (notifications.length) { %>
    <ul>
      <% notifications.forEach(function (notification) { %>
        <li class="<%= notification.read_at ? 'is-read' : 'is-unread' %>">
          <p><%= notification.message %></p>
          <small><%= notification.created_at %></small>
          <% if (!notification.read_at) { %>
            <form method="post" action="/account/notifications/<%= notification.id %>/read">
              <button type="submit" class="btn secondary"><%= copy.markRead %></button>
            </form>
          <% } %>
        </li>
      <% }); %>
    </ul>
  <% } else { %>
    <p><%= copy.notificationsEmpty %></p>
  <% } %>
  <% if (smtpConfigured) { %>
    <p class="account-email-note"><%= copy.emailNotificationNote %></p>
  <% } %>
</section>

<section class="account-followup">
  <article class="card">
    <h2><%= copy.schedule %></h2>
    <% if (lessons.length) { %>
      <ul class="account-lesson-list">
        <% lessons.forEach(function (lesson) { %>
          <li>
            <div>
              <strong><%= lesson.starts_at.replace("T", " ") %></strong>
              <span><%= copy.lessonDuration %>: <%= lesson.duration_minutes %> <%= copy.minutes %></span>
            </div>
            <div>
              <span><%= lesson.instructorName || copy.unknown %></span>
              <span class="status-pill status-pill--<%= lesson.status === 'attended' ? 'closed' : lesson.status === 'planned' ? 'new' : 'contacted' %>">
                <%= lesson.status === "attended" ? copy.lessonAttended : lesson.status === "missed" ? copy.lessonMissed : lesson.status === "cancelled" ? copy.lessonCancelled : copy.lessonPlanned %>
              </span>
            </div>
            <% if (lesson.internal_note) { %>
              <p><%= lesson.internal_note %></p>
            <% } %>
          </li>
        <% }); %>
      </ul>
    <% } else { %>
      <p><%= copy.lessonsEmpty %></p>
    <% } %>
  </article>
  <article class="card">
    <h2><%= copy.attendance %></h2>
    <p><%= copy.progressSummary %>: <strong><%= attendedLessons %> / <%= completedLessons %></strong></p>
    <div class="account-progress" role="progressbar" aria-valuenow="<%= progressPercent %>" aria-valuemin="0" aria-valuemax="100">
      <span style="width: <%= progressPercent %>%"></span>
    </div>
    <% if (!completedLessons) { %>
      <p><%= copy.progressEmpty %></p>
    <% } %>
  </article>
</section>

<%- include("../partials/footer") %>
