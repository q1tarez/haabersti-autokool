<%- include("../partials/header", { title, currentPath: '/courses' }) %>

<section>
  <h1><%= t("coursesTitle") %></h1>
  <p class="section-lead"><%= t("coursesLead") %></p>
  <div class="cards">
    <% courses.forEach((course) => { %>
      <article class="card">
        <h2><%= course.name %></h2>
        <p><%= course.description %></p>
        <p class="price-badge"><strong><%= t("price") %>:</strong> <%= course.price %></p>
        <p><strong><%= t("duration") %>:</strong> <%= course.duration %></p>
        <a class="btn" href="/register/steps?course=<%= course.id %>"><%= t("registerShort") %></a>
      </article>
    <% }) %>
  </div>
</section>

<%- include("../partials/footer") %>
