<%- include("../partials/header", { title, hideStickyCta: true, currentPath: '/account' }) %>

<section class="card account-card">
  <h1><%= copy.passwordForgotTitle %></h1>
  <p class="section-lead"><%= copy.passwordForgotLead %></p>
  <% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>
  <% if (notice) { %><p class="thanks-notice thanks-notice--ok" role="status"><%= notice %></p><% } %>
  <form class="account-form" method="post" action="/account/password/forgot">
    <label>
      <span><%= copy.email %></span>
      <input type="email" name="email" autocomplete="email" maxlength="200" required />
    </label>
    <button class="btn" type="submit"><%= copy.sendResetLink %></button>
  </form>
  <p class="account-switch"><a href="/account/login"><%= copy.signIn %></a></p>
</section>

<%- include("../partials/footer") %>
