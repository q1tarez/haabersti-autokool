<% const locSlugKeys = [{ s: "kopli", k: "filterLocKopli" }, { s: "mustamae", k: "filterLocMustamae" }, { s: "lasnamae", k: "filterLocLasnamae" }, { s: "haabersti", k: "filterLocHaabersti" }, { s: "kristiine", k: "filterLocKristiine" }, { s: "viimsi", k: "filterLocViimsi" }, { s: "pirita", k: "filterLocPirita" }, { s: "maardu", k: "filterLocMaardu" }, { s: "ulemiste", k: "filterLocUlemiste" }, { s: "kadaka", k: "filterLocKadaka" }]; %>
<div id="instructorBlock" class="instructor-block" <%= typeof showInstrBoot !== 'undefined' && showInstrBoot ? "" : "hidden" %>>
  <p class="instructor-step-lead instructor-step-lead--strong"><%= t("instructorSectionTitle") %></p>

  <div id="instructorFilterBar" class="instructor-filter-panel">
    <p class="visually-hidden" id="instructorRadiogroupLabel"><%= t("instructorSectionTitle") %></p>

    <div class="filter-chip-row">
      <span class="filter-field-label"><%= t("instructorFilterGroupLang") %></span>
      <div class="filter-chip-group" data-filter-group="lang">
        <button type="button" class="filter-chip" data-filter-value="any"><%= t("filterNeutralLang") %></button>
        <button type="button" class="filter-chip" data-filter-value="et"><%= t("filterLangEt") %></button>
        <button type="button" class="filter-chip is-selected" data-filter-value="ru" aria-pressed="true"><%= t("filterLangRu") %></button>
        <button type="button" class="filter-chip" data-filter-value="en"><%= t("filterLangEn") %></button>
      </div>
    </div>

    <div class="filter-chip-row">
      <span class="filter-field-label"><%= t("instructorFilterTransmission") %></span>
      <div class="filter-chip-group" data-filter-group="transmission">
        <button type="button" class="filter-chip is-selected" data-filter-value="any" aria-pressed="true"><%= t("filterNeutralTrans") %></button>
        <button type="button" class="filter-chip" data-filter-value="manual"><%= t("filterTransManual") %></button>
        <button type="button" class="filter-chip" data-filter-value="automatic"><%= t("filterTransAutomatic") %></button>
      </div>
    </div>

    <div class="filter-chip-row">
      <span class="filter-field-label"><%= t("instructorFilterCategory") %></span>
      <div class="filter-chip-group" data-filter-group="category">
        <button type="button" class="filter-chip" data-filter-value="any"><%= t("filterNeutralCat") %></button>
        <button type="button" class="filter-chip is-selected" data-filter-value="b" aria-pressed="true"><%= t("filterCatB") %></button>
        <button type="button" class="filter-chip" data-filter-value="be"><%= t("filterCatBE") %></button>
        <button type="button" class="filter-chip" data-filter-value="moto"><%= t("filterCatMoto") %></button>
      </div>
    </div>

    <div class="filter-chip-row">
      <span class="filter-field-label"><%= t("instructorFilterLocation") %></span>
      <div class="filter-chip-group filter-chip-group--wrap" data-filter-group="location">
        <button type="button" class="filter-chip is-selected" data-filter-value="any" aria-pressed="true"><%= t("filterNeutralLoc") %></button>
        <% locSlugKeys.forEach(({ s, k }) => { %>
          <button type="button" class="filter-chip" data-filter-value="<%= s %>"><%= t(k) %></button>
        <% }) %>
      </div>
    </div>

    <div class="filter-search-row">
      <label class="filter-field-label" for="instructorSearchInput"><%= t("instructorFilterSearch") %></label>
      <span class="filter-search-inner">
        <svg class="filter-search-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="10" cy="10" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input type="search" id="instructorSearchInput" class="inst-search-field" autocomplete="off" placeholder="<%= t('instructorSearchPlaceholder') %>" />
      </span>
    </div>

    <div class="filter-chip-row">
      <span class="filter-field-label"><%= t("instructorFilterSort") %></span>
      <div class="filter-chip-group" data-filter-group="sort">
        <button type="button" class="filter-chip is-selected" data-filter-value="first-lesson" aria-pressed="true"><%= t("instructorSortFirstLesson") %></button>
        <button type="button" class="filter-chip" data-filter-value="rating"><%= t("instructorSortRating") %></button>
        <button type="button" class="filter-chip" data-filter-value="price"><%= t("instructorSortPrice") %></button>
      </div>
    </div>
  </div>

  <p id="instructorFilterError" class="alert error instructor-filter-msg" hidden role="alert"></p>
  <p id="instructorNoResults" class="instructor-empty-list" hidden><%= t("instructorNoResults") %></p>

  <div id="instructorCardsRoot" class="instructor-picker-cards" role="radiogroup" aria-labelledby="instructorRadiogroupLabel">
    <% drivingInstructors.forEach((instr) => { %>
      <article
        class="instructor-hub-card"
        data-inst-langs="<%= instr.filterGroupLanguages.join(" ") %>"
        data-inst-trans="<%= instr.transmissionKey %>"
        data-inst-cats="<%= instr.filterCategories.join(" ") %>"
        data-inst-locs="<%= instr.filterLocationIds.join(" ") %>"
        data-inst-days="<%= instr.firstLessonDays %>"
        data-inst-rating="<%= instr.rating %>"
        data-inst-price="<%= instr.sortPriceNumber %>"
        data-inst-search="<%= instr.searchHaystack %>"
      >
        <input
          type="radio"
          name="instructorId"
          value="<%= instr.id %>"
          id="inst-radio-<%= instr.id %>"
          data-price-package="<%= instr.pricePackage %>"
          data-price-lesson="<%= instr.pricePerLesson %>"
          data-label="<%= instr.name %>"
          data-inst-location="<%= instr.location %>"
          class="instructor-radio"
          <%= typeof showInstrBoot !== 'undefined' && showInstrBoot ? "" : "disabled" %>
        />
        <div class="hub-card-photo">
          <img class="hub-photo-round" src="<%= instr.photo %>" alt="" width="96" height="96" loading="lazy" />
        </div>
        <div class="hub-card-center">
          <div class="hub-card-head">
            <% if (instr.badgePro) { %>
              <span class="hub-pro-badge">★ <%= t("instructorBadgePro") %></span>
            <% } %>
            <h4 class="hub-name"><%= instr.name %></h4>
          </div>
          <div class="hub-price-row">
            <div class="hub-price-cell">
              <span class="hub-euro" aria-hidden="true">€</span>
              <span class="hub-price-label"><%= t("instructorCostShort") %></span>
              <span class="hub-price-value"><%= instr.priceFormattedPackage %></span>
            </div>
            <div class="hub-price-cell">
              <span class="hub-euro" aria-hidden="true">€</span>
              <span class="hub-price-label"><%= t("instructorPerLessonNote") %></span>
              <span class="hub-price-value"><%= instr.priceLessonFormatted %></span>
            </div>
          </div>
          <div class="hub-info-grid">
            <div class="hub-info-item">
              <svg class="hub-svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 6v6l4 2" />
              </svg>
              <div>
                <span class="hub-info-lbl"><%= t("instructorFirstLesson") %></span>
                <span class="hub-info-val hub-info-accent"><%= instr.firstLessonEta %></span>
              </div>
            </div>
            <div class="hub-info-item">
              <svg class="hub-svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="M7 11V7a5 5 0 0110 0v4" />
                <path d="M7 21h10l1-10H6l1 10z" />
              </svg>
              <div>
                <span class="hub-info-lbl"><%= t("instructorRatingTotalShort") %></span>
                <span class="hub-info-val"><%= instr.rating %> (<%= instr.reviewCount %>)</span>
              </div>
            </div>
            <div class="hub-info-item">
              <svg class="hub-svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="M12 21s-6-5-6-10a6 6 0 1112 0c0 5-6 10-6 10z" />
                <circle cx="12" cy="11" r="2.5" />
              </svg>
              <div>
                <span class="hub-info-lbl"><%= t("instructorMeetingPoint") %></span>
                <span class="hub-info-val"><%= instr.location %></span>
              </div>
            </div>
            <div class="hub-info-item">
              <svg class="hub-svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <circle cx="12" cy="12" r="3" />
                <path d="M12 2v4M12 18v4M5 5l3 3M16 16l3 3M2 12h4M18 12h4" />
              </svg>
              <div>
                <span class="hub-info-lbl"><%= t("instructorTransmission") %></span>
                <span class="hub-info-val"><%= instr.transmission %></span>
              </div>
            </div>
            <div class="hub-info-item">
              <svg class="hub-svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="M4 5h16M9 11h11M9 17h11" />
              </svg>
              <div>
                <span class="hub-info-lbl"><%= t("instructorLanguageLabel") %></span>
                <span class="hub-info-val"><%= instr.spokenLanguage %></span>
              </div>
            </div>
            <div class="hub-info-item">
              <svg class="hub-svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <rect x="2" y="5" width="20" height="14" rx="2" />
                <path d="M2 10h20" />
              </svg>
              <div>
                <span class="hub-info-lbl"><%= t("instructorPayPerLessonShort") %></span>
                <% if (instr.payPerLessonOk) { %>
                  <span class="hub-info-val"><span class="hub-check">✓</span></span>
                <% } %>
              </div>
            </div>
          </div>
        </div>
        <div class="hub-card-actions">
          <button
            type="button"
            class="btn-hub-select hub-select-trigger"
            data-open-dialog="inst-dialog-<%= instr.id %>"
          >
            <%= t("instructorChooseBtn") %> ›
          </button>
          <button type="button" class="btn-hub-info" data-open-dialog="inst-dialog-<%= instr.id %>">
            <span class="btn-hub-info-ico">i</span>
            <%= t("instructorMoreInfoBtn") %>
          </button>
        </div>
      </article>
    <% }) %>
  </div>
</div>
