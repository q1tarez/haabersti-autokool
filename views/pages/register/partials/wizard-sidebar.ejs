<aside class="wizard-sidebar" aria-label="<%= t('registerWizardTitle') %>">
  <ol class="wizard-sidebar-list">
    <li class="wizard-sidebar-item">
      <button type="button" class="wizard-dot active" data-step="1" aria-current="step"><span class="wizard-dot-num">1</span></button>
      <div class="wizard-sidebar-labels">
        <span class="wizard-sidebar-kicker"><%= t("wizardSidebarStep") %> 1</span>
        <span class="wizard-sidebar-title"><%= t("wizardStepLang") %></span>
      </div>
    </li>
    <li class="wizard-sidebar-item">
      <button type="button" class="wizard-dot" data-step="2"><span class="wizard-dot-num">2</span></button>
      <div class="wizard-sidebar-labels">
        <span class="wizard-sidebar-kicker"><%= t("wizardSidebarStep") %> 2</span>
        <span class="wizard-sidebar-title"><%= t("wizardStepCategory") %></span>
      </div>
    </li>
    <li class="wizard-sidebar-item">
      <button type="button" class="wizard-dot" data-step="3"><span class="wizard-dot-num">3</span></button>
      <div class="wizard-sidebar-labels">
        <span class="wizard-sidebar-kicker"><%= t("wizardSidebarStep") %> 3</span>
        <span class="wizard-sidebar-title"><%= t("wizardStepTraining") %></span>
      </div>
    </li>
    <li class="wizard-sidebar-item">
      <button type="button" class="wizard-dot" data-step="4"><span class="wizard-dot-num">4</span></button>
      <div class="wizard-sidebar-labels">
        <span class="wizard-sidebar-kicker"><%= t("wizardSidebarStep") %> 4</span>
        <span class="wizard-sidebar-title"><%= t("wizardStepGroup") %></span>
      </div>
    </li>
  </ol>
</aside>
