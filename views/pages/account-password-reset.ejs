<%- include("../partials/header", { title, hideStickyCta: true, currentPath: '/account' }) %>

<section class="card account-card">
  <h1><%= copy.passwordResetTitle %></h1>
  <% if (invalid) { %>
    <p class="form-error" role="alert"><%= copy.passwordResetInvalid %></p>
    <p class="account-switch"><a href="/account/password/forgot"><%= copy.forgotPassword %></a></p>
  <% } else { %>
    <p class="section-lead"><%= copy.passwordResetLead %></p>
    <% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>
    <form class="account-form" method="post" action="/account/password/reset/<%= token %>">
      <label>
        <span><%= copy.newPassword %></span>
        <input type="password" name="password" autocomplete="new-password" minlength="10" maxlength="72" required />
      </label>
      <label>
        <span><%= copy.confirmNewPassword %></span>
        <input type="password" name="confirmPassword" autocomplete="new-password" minlength="10" maxlength="72" required />
      </label>
      <button class="btn" type="submit"><%= copy.saveNewPassword %></button>
    </form>
  <% } %>
</section>

<%- include("../partials/footer") %>
