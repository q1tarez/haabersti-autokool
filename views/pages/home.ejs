<%- include("../partials/header", { title, currentPath: '/' }) %>

<div class="home-page">
  <section class="hero hero--visual">
    <div class="hero-copy">
      <p class="eyebrow">Haabersti Autokool</p>
      <h1 class="hero-title-xl"><%= t("heroTitle") %></h1>
      <p class="hero-text"><%= t("heroText") %></p>
      <div class="hero-actions">
        <a class="btn btn-accent" href="/register/steps"><%= t("registerCourse") %></a>
        <a class="btn secondary" href="/courses"><%= t("viewCourses") %></a>
      </div>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <img src="/images/hero/hero-scene.svg" alt="" width="640" height="416" loading="eager" decoding="async" class="hero-visual-img" />
    </div>
  </section>

  <% if (bCategoryPrice) { %>
  <section class="home-pricing-anchor card" id="pricing">
    <div class="home-pricing-inner">
      <div>
        <h2><%= t("homePricingTitle") %></h2>
        <p class="section-lead"><%= t("homePricingLead") %></p>
      </div>
      <p class="home-pricing-price"><span class="home-pricing-from"><%= lang === 'ru' ? 'от' : lang === 'en' ? 'from' : 'alates' %></span> <strong><%= bCategoryPrice %></strong></p>
      <div class="hero-actions">
        <a class="btn btn-accent" href="/register/steps?course=b-category"><%= t("registerShort") %></a>
        <a class="btn secondary" href="/prices"><%= t("homePricingCta") %></a>
      </div>
    </div>
  </section>
  <% } %>

  <section class="home-section">
    <div class="home-section-head">
      <h2><%= t("homeFeaturesTitle") %></h2>
      <p class="section-lead"><%= t("homeFeaturesLead") %></p>
    </div>
    <div class="home-features">
      <article class="home-feature card">
        <span class="home-feature-icon home-feature-icon--svg" aria-hidden="true"><%- include("../partials/icons", { icon: 'instructor' }) %></span>
        <h3><%= t("homeFeature1Title") %></h3>
        <p><%= t("homeFeature1Text") %></p>
      </article>
      <article class="home-feature card">
        <span class="home-feature-icon home-feature-icon--svg" aria-hidden="true"><%- include("../partials/icons", { icon: 'clock' }) %></span>
        <h3><%= t("homeFeature2Title") %></h3>
        <p><%= t("homeFeature2Text") %></p>
      </article>
      <article class="home-feature card">
        <span class="home-feature-icon home-feature-icon--svg" aria-hidden="true"><%- include("../partials/icons", { icon: 'book' }) %></span>
        <h3><%= t("homeFeature3Title") %></h3>
        <p><%= t("homeFeature3Text") %></p>
      </article>
      <article class="home-feature card">
        <span class="home-feature-icon home-feature-icon--svg" aria-hidden="true"><%- include("../partials/icons", { icon: 'snow' }) %></span>
        <h3><%= t("homeFeature4Title") %></h3>
        <p><%= t("homeFeature4Text") %></p>
      </article>
    </div>
  </section>

  <section class="home-section">
    <div class="home-section-head">
      <h2><%= t("homeHowTitle") %></h2>
    </div>
    <div class="home-how-scroll" tabindex="0">
      <article class="home-how-slide card">
        <span class="home-step-num">1</span>
        <h3><%= t("homeHow1Title") %></h3>
        <p><%= t("homeHow1Text") %></p>
      </article>
      <article class="home-how-slide card">
        <span class="home-step-num">2</span>
        <h3><%= t("homeHow2Title") %></h3>
        <p><%= t("homeHow2Text") %></p>
      </article>
      <article class="home-how-slide card">
        <span class="home-step-num">3</span>
        <h3><%= t("homeHow3Title") %></h3>
        <p><%= t("homeHow3Text") %></p>
      </article>
    </div>
  </section>

  <section class="home-section home-section--soft">
    <div class="home-section-head">
      <h2><%= t("homeStepsTitle") %></h2>
      <p class="section-lead"><%= t("homeStepsLead") %></p>
    </div>
    <ol class="home-steps">
      <li class="home-step card">
        <span class="home-step-num">1</span>
        <h3><%= t("homeStep1Title") %></h3>
        <p><%= t("homeStep1Text") %></p>
      </li>
      <li class="home-step card">
        <span class="home-step-num">2</span>
        <h3><%= t("homeStep2Title") %></h3>
        <p><%= t("homeStep2Text") %></p>
      </li>
      <li class="home-step card">
        <span class="home-step-num">3</span>
        <h3><%= t("homeStep3Title") %></h3>
        <p><%= t("homeStep3Text") %></p>
      </li>
      <li class="home-step card">
        <span class="home-step-num">4</span>
        <h3><%= t("homeStep4Title") %></h3>
        <p><%= t("homeStep4Text") %></p>
      </li>
    </ol>
    <p class="home-steps-cta">
      <a class="btn" href="/register/steps"><%= t("registerCourse") %></a>
    </p>
  </section>

  <% if (courses && courses.length) { %>
    <section class="home-section">
      <div class="home-section-head home-section-head--row">
        <div>
          <h2><%= t("homeCoursesTitle") %></h2>
          <p class="section-lead"><%= t("homeCoursesLead") %></p>
        </div>
        <a class="btn secondary home-section-link" href="/courses"><%= t("homeCoursesAll") %> →</a>
      </div>
      <div class="cards home-course-cards">
        <% courses.forEach((course) => { %>
          <article class="card home-course-card course-card-v2">
            <h3><%= course.name %></h3>
            <% if (course.forWhom) { %><p class="course-for-whom"><strong><%= t("courseForWhom") %>:</strong> <%= course.forWhom %></p><% } %>
            <p class="home-course-desc"><%= course.description %></p>
            <p class="price-badge"><strong><%= t("price") %>:</strong> <%= course.price %></p>
            <% if (course.duration) { %>
              <p class="home-course-meta"><strong><%= t("duration") %>:</strong> <%= course.duration %></p>
            <% } %>
            <a class="btn btn-accent" href="/register/steps?course=<%= course.id %>"><%= t("registerShort") %></a>
          </article>
        <% }) %>
      </div>
    </section>
  <% } %>

  <section class="home-section">
    <div class="home-section-head">
      <h2><%= t("homeOfferingsTitle") %></h2>
    </div>
    <div class="home-offerings">
      <article class="home-offering card">
        <h3><%= t("homeOffering1Title") %></h3>
        <p><%= t("homeOffering1Text") %></p>
        <a class="home-offering-link" href="/register/steps"><%= t("registerShort") %> →</a>
      </article>
      <article class="home-offering card">
        <h3><%= t("homeOffering2Title") %></h3>
        <p><%= t("homeOffering2Text") %></p>
        <a class="home-offering-link" href="/courses"><%= t("viewCourses") %> →</a>
      </article>
      <article class="home-offering card">
        <h3><%= t("homeOffering3Title") %></h3>
        <p><%= t("homeOffering3Text") %></p>
        <ul class="home-lang-list">
          <li><%= t("filterLangEt") %></li>
          <li><%= t("filterLangRu") %></li>
          <li><%= t("filterLangEn") %></li>
        </ul>
      </article>
    </div>
  </section>

  <section class="home-section">
    <div class="home-section-head home-section-head--row">
      <div>
        <h2><%= t("faqTitle") %></h2>
        <p class="section-lead"><%= t("faqLead") %></p>
      </div>
      <a class="btn secondary home-section-link" href="/faq"><%= t("navFaq") %> →</a>
    </div>
    <div class="faq-list faq-list--compact">
      <% [1, 2, 3].forEach((i) => { %>
        <details class="faq-item card">
          <summary><%= t("faq" + i + "q") %></summary>
          <p><%= t("faq" + i + "a") %></p>
        </details>
      <% }) %>
    </div>
  </section>

  <section class="home-section home-section--soft">
    <div class="home-section-head">
      <h2><%= t("homeAreasTitle") %></h2>
      <p class="section-lead"><%= t("homeAreasLead") %></p>
    </div>
    <ul class="home-areas">
      <li><%= t("filterLocHaabersti") %></li>
      <li><%= t("filterLocMustamae") %></li>
      <li><%= t("filterLocKristiine") %></li>
      <li><%= t("filterLocKopli") %></li>
      <li><%= t("filterLocLasnamae") %></li>
      <li><%= t("filterLocPirita") %></li>
      <li><%= t("filterLocViimsi") %></li>
    </ul>
    <p class="home-areas-note"><%= t("homeAreasNote") %></p>
  </section>

  <% if (typeof reviews !== 'undefined' && reviews && reviews.length) { %>
  <section class="home-section home-reviews">
    <div class="home-section-head">
      <h2><%= t("homeReviewsTitle") %></h2>
      <p class="section-lead"><%= t("homeReviewsLead") %></p>
    </div>
    <div class="home-reviews-grid">
      <% reviews.forEach((r) => { %>
        <blockquote class="home-review card">
          <p class="home-review-text">“<%= r.text %>”</p>
          <footer>
            <strong><%= r.name %></strong>
            <span class="home-review-stars" aria-label="<%= r.rating %>/5"><%= "★".repeat(r.rating) %></span>
          </footer>
        </blockquote>
      <% }) %>
    </div>
  </section>
  <% } %>

  <% if (typeof instagramUrl !== 'undefined' && instagramUrl) { %>
  <section class="home-section home-instagram card">
    <h2><%= t("homeInstagramTitle") %></h2>
    <p class="section-lead"><%= t("homeInstagramLead") || "" %></p>
    <a class="btn secondary" href="<%= instagramUrl %>" target="_blank" rel="noopener noreferrer"><%= t("homeInstagramCta") %></a>
  </section>
  <% } %>

  <section class="home-cta card">
    <h2><%= t("homeCtaTitle") %></h2>
    <p><%= t("homeCtaText") %></p>
    <div class="hero-actions">
      <a class="btn btn-accent" href="/register/steps"><%= t("registerCourse") %></a>
      <a class="btn secondary" href="/consultation"><%= t("navConsultation") %></a>
    </div>
  </section>
</div>

<%- include("../partials/footer") %>
