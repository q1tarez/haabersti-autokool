<%- include("../partials/header", { title, currentPath: '/' }) %>

<section class="hero">
  <div>
    <p class="eyebrow">Haabersti Autokool</p>
    <h1><%= t("heroTitle") %></h1>
    <p class="hero-text"><%= t("heroText") %></p>
    <div class="hero-actions">
      <a class="btn" href="/register/steps"><%= t("registerCourse") %></a>
      <a class="btn secondary" href="/courses"><%= t("viewCourses") %></a>
    </div>
  </div>
  <aside class="hero-card">
    <h2><%= t("whyChooseUs") %></h2>
    <ul>
      <li><%= t("heroPoint1") %></li>
      <li><%= t("heroPoint2") %></li>
      <li><%= t("heroPoint3") %></li>
    </ul>
  </aside>
</section>

<section class="stats" aria-label="<%= lang === 'ru' ? 'Статистика' : lang === 'en' ? 'Statistics' : 'Statistika' %>">
  <article>
    <p class="number" aria-label="90%">90%</p>
    <p><%= t("stat1") %></p>
  </article>
  <article>
    <p class="number" aria-label="<%= lang === 'ru' ? '10+ лет' : '10+ years' %>">10+</p>
    <p><%= t("stat2") %></p>
  </article>
  <article>
    <p class="number" aria-label="<%= lang === 'ru' ? '200+ учеников' : '200+ students' %>">200+</p>
    <p><%= t("stat3") %></p>
  </article>
</section>

<%- include("../partials/footer") %>
