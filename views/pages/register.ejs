<% const showInstrBoot = courses.some((c) => c.id === selectedCourseId && c.requiresInstructor); %>
<% const showTrainingBoot = courses.some((c) => c.id === selectedCourseId && c.requiresTrainingOffer); %>
<%- include("../partials/header", { title }) %>

<section class="registration-section registration-section--wizard">
  <h1 class="wizard-page-title"><%= t("registerWizardTitle") %></h1>
  <p class="section-lead wizard-page-lead"><%= t("registerLead") %></p>

  <% if (error) { %>
    <p class="alert error"><%= error %></p>
  <% } %>
  <% if (success) { %>
    <div class="alert success">
      <p><%= success %></p>
      <% if (typeof successBankInfo !== "undefined" && successBankInfo) { %>
        <p class="success-bank-note"><%= successBankInfo %></p>
      <% } %>
    </div>
  <% } %>

  <div class="registration-layout registration-layout--sky">
    <%- include("./register/partials/wizard-sidebar") %>

    <div class="wizard-main wizard-main--shell">
    <form
      class="form card form-card step-form wizard-step-card"
      method="POST"
      action="/register"
      id="stepForm"
      data-initial-course="<%= selectedCourseId || "" %>"
      data-pick-msg="<%= String(t("instructorPickVisibleError")).replace(/"/g, "&quot;").replace(/</g, "&lt;") %>"
      data-training-pick-msg="<%= String(t("trainingOfferPickVisibleError")).replace(/"/g, "&quot;").replace(/</g, "&lt;") %>"
    >
      <input type="hidden" name="uiLang" id="hid_uiLang" value="<%= lang %>" />
      <%- include("./register/partials/step-lang") %>
      <%- include("./register/partials/step-category") %>
      <%- include("./register/partials/step-course") %>
      <%- include("./register/partials/step-group") %>
      <%- include("./register/partials/step-actions") %>
      <input type="hidden" name="fullName" id="fullName" value="" />
      <input type="hidden" name="firstName" id="hid_firstName" value="" />
      <input type="hidden" name="lastName" id="hid_lastName" value="" />
      <input type="hidden" name="isikukood" id="hid_isikukood" value="" />
      <input type="hidden" name="phone" id="hid_phone" value="" />
      <input type="hidden" name="email" id="hid_email" value="" />
      <input type="hidden" name="paymentMethod" id="hid_paymentMethod" value="" />
      <input type="hidden" name="comment" id="hid_comment" value="" />
    </form>
    <%- include("./register/partials/registration-modals") %>
    </div>
  </div>

  <%- include("./register/partials/dialogs-courses") %>
  <%- include("./register/partials/dialogs-instructors") %>
  <%- include("./register/partials/dialogs-training") %>
</section>

<%- include("./register/partials/wizard-script") %>
<%- include("../partials/footer") %>
