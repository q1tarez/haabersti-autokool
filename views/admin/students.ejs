<%- include("../partials/admin-header", { title }) %>

<header class="admin-page-header">
  <h1>Записавшиеся ученики</h1>
  <p class="section-lead">Просмотр регистраций, поиск и смена статуса заявки.</p>
  <% if (typeof reminderFlash !== 'undefined' && reminderFlash === 'sent') { %>
    <p class="admin-flash admin-flash--ok">Письмо с напоминанием об оплате отправлено.</p>
  <% } else if (reminderFlash === 'failed') { %>
    <p class="admin-flash admin-flash--warn">Не удалось отправить письмо.</p>
  <% } else if (reminderFlash === 'no_smtp') { %>
    <p class="admin-flash admin-flash--warn">SMTP не настроен — письмо недоступно.</p>
  <% } else if (reminderFlash === 'no_email') { %>
    <p class="admin-flash admin-flash--warn">У ученика нет email.</p>
  <% } %>
</header>

<form class="card filter-bar" method="GET" action="/admin/students">
  <input type="text" name="search" placeholder="Поиск: имя, исикукод, телефон, email, курс" value="<%= search %>" />
  <select name="status">
    <option value="">Все статусы</option>
    <option value="new" <%= status === "new" ? "selected" : "" %>>Новая</option>
    <option value="contacted" <%= status === "contacted" ? "selected" : "" %>>Связались</option>
    <option value="closed" <%= status === "closed" ? "selected" : "" %>>Закрыта</option>
  </select>
  <select name="courseId">
    <option value="">Все курсы</option>
    <% (courseOptions || []).forEach((c) => { %>
      <option value="<%= c.id %>" <%= courseId === c.id ? "selected" : "" %>><%= c.name_ru || c.name_et %></option>
    <% }) %>
  </select>
  <input type="date" name="dateFrom" value="<%= dateFrom || '' %>" aria-label="С даты" />
  <input type="date" name="dateTo" value="<%= dateTo || '' %>" aria-label="По дату" />
  <button class="btn" type="submit">Фильтровать</button>
  <a class="btn secondary" href="/admin/students/export.csv?search=<%= encodeURIComponent(search || '') %>&status=<%= encodeURIComponent(status || '') %>&courseId=<%= encodeURIComponent(courseId || '') %>&dateFrom=<%= encodeURIComponent(dateFrom || '') %>&dateTo=<%= encodeURIComponent(dateTo || '') %>">CSV</a>
</form>

<div class="card table-wrap admin-table-card">
  <table class="admin-table admin-table--students">
    <thead>
      <tr>
        <th class="admin-col-date">Дата</th>
        <th>Ученик</th>
        <th>Контакты</th>
        <th>Курс</th>
        <th>Комментарий</th>
        <th class="admin-col-payment">Оплата</th>
        <th class="admin-col-status">Статус</th>
        <th class="admin-col-actions">Действия</th>
      </tr>
    </thead>
    <tbody>
      <% students.forEach((item) => { %>
        <% const pay = item.payment_status === "paid" ? "paid" : "unpaid"; %>
        <% const st = item.status || "new"; %>
        <tr class="student-row student-row--<%= st %>">
          <td class="admin-col-date"><%= formatEtDateTime(item.created_at) %></td>
          <td><strong><%= item.full_name %></strong></td>
          <td>
            IK: <%= item.isikukood || "-" %><br />
            <%= item.phone %><br />
            <%= item.email %>
          </td>
          <td><%= item.course_name %><br /><small>Start: <%= item.start_date || "-" %></small></td>
          <td>
            <p><%= item.comment || "—" %></p>
            <form method="POST" action="/admin/students/<%= item.id %>/note" class="admin-note-form">
              <label class="visually-hidden">Внутренняя заметка</label>
              <textarea name="internal_note" rows="2" placeholder="Заметка (только админ)"><%= item.internal_note || "" %></textarea>
              <button class="btn secondary" type="submit">Заметка</button>
            </form>
          </td>
          <td class="admin-col-payment">
            <form method="POST" action="/admin/students/<%= item.id %>/payment" class="inline-form admin-student-form">
              <select name="payment_status" aria-label="Статус оплаты">
                <option value="unpaid" <%= pay === "unpaid" ? "selected" : "" %>>Не оплачено</option>
                <option value="paid" <%= pay === "paid" ? "selected" : "" %>>Оплачено</option>
              </select>
              <button class="btn secondary" type="submit">OK</button>
            </form>
            <% if (pay === "unpaid" && item.email && smtpConfigured) { %>
              <form method="POST" action="/admin/students/<%= item.id %>/payment-reminder" class="inline-form admin-reminder-form" onsubmit="return confirm('Отправить напоминание об оплате на <%= item.email %>?');">
                <input type="hidden" name="mailLang" value="ru" />
                <button class="btn secondary btn--compact" type="submit" title="Email с реквизитами">Напомнить</button>
              </form>
            <% } %>
          </td>
          <td class="admin-col-status">
            <span class="status-pill status-pill--<%= st %>"><%= st %></span>
            <form method="POST" action="/admin/students/<%= item.id %>/status" class="inline-form admin-student-form">
              <select name="status" class="status-select status-select--<%= st %>" aria-label="Статус заявки">
                <option value="new" <%= item.status === "new" ? "selected" : "" %>>Новая</option>
                <option value="contacted" <%= item.status === "contacted" ? "selected" : "" %>>Связались</option>
                <option value="closed" <%= item.status === "closed" ? "selected" : "" %>>Закрыта</option>
              </select>
              <button class="btn secondary" type="submit">OK</button>
            </form>
          </td>
          <td class="table-actions admin-col-actions">
            <form
              method="POST"
              action="/admin/students/<%= item.id %>/delete"
              class="inline-form"
              onsubmit="return confirm('Удалить эту регистрацию?');"
            >
              <button class="btn danger" type="submit">Удалить</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include("../partials/admin-footer") %>
