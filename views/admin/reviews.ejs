<%- include("../partials/admin-header", { title }) %>

<header class="admin-page-header">
  <h1>Отзывы на сайте</h1>
</header>
<% if (saved) { %><p class="admin-alert admin-alert--ok">Сохранено.</p><% } %>

<div class="card admin-form-card">
  <h2>Добавить отзыв</h2>
  <form method="POST" action="/admin/reviews" class="admin-form-stack admin-reviews-form">
    <div class="admin-form-field">
      <label for="review-name">Имя</label>
      <input id="review-name" class="admin-input" name="name" placeholder="Анна К." required />
    </div>
    <div class="admin-form-grid-3">
      <div class="admin-form-field">
        <label for="review-et">Текст ET</label>
        <textarea id="review-et" class="admin-input" name="text_et" rows="3" required></textarea>
      </div>
      <div class="admin-form-field">
        <label for="review-ru">Текст RU</label>
        <textarea id="review-ru" class="admin-input" name="text_ru" rows="3"></textarea>
      </div>
      <div class="admin-form-field">
        <label for="review-en">Текст EN</label>
        <textarea id="review-en" class="admin-input" name="text_en" rows="3"></textarea>
      </div>
    </div>
    <div class="admin-form-row admin-form-row--meta">
      <div class="admin-form-field admin-form-field--narrow">
        <label for="review-rating">Оценка (1–5)</label>
        <input id="review-rating" class="admin-input" name="rating" type="number" min="1" max="5" value="5" />
      </div>
      <div class="admin-form-field admin-form-field--narrow">
        <label for="review-order">Порядок</label>
        <input id="review-order" class="admin-input" name="sort_order" type="number" value="0" />
      </div>
      <div class="admin-form-field admin-form-field--submit">
        <button class="btn" type="submit">Добавить</button>
      </div>
    </div>
  </form>
</div>

<div class="card table-wrap admin-table-card">
  <table class="admin-table admin-table--reviews">
    <thead><tr><th>Имя</th><th>ET</th><th>★</th><th></th></tr></thead>
    <tbody>
      <% items.forEach((item) => { %>
        <tr>
          <td><%= item.name %></td>
          <td class="admin-cell-truncate"><%= item.text_et || "" %></td>
          <td><%= item.rating %></td>
          <td>
            <form method="POST" action="/admin/reviews/<%= item.id %>/toggle" class="inline-form">
              <button class="btn secondary" type="submit"><%= item.is_active ? "Скрыть" : "Показать" %></button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include("../partials/admin-footer") %>
