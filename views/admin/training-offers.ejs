<%- include("../partials/admin-header", { title }) %>

<header class="admin-page-header">
  <h1>Тренинги и группы (карточки регистрации)</h1>
  <p class="section-lead">
    Карточки на шаге «Группа» для зимнего вождения, первой помощи, тёмного и скользкого вождения. Поля совпадают с отображением на сайте.
  </p>
</header>

<% if (notice) { %>
  <p class="admin-notice"><%= notice %></p>
<% } %>

<div class="registration-layout admin-split-layout admin-management-layout">
    <div class="card admin-editor-card">
      <h2><%= editingId ? "Изменить предложение" : "Добавить предложение" %></h2>
      <p class="admin-editor-hint">Заполните параметры группы и карточки. Переводы раскрываются отдельно по языкам.</p>
      <form class="form instructor-admin-form" method="POST" action="<%= editingId ? `/admin/training-offers/${encodeURIComponent(editingId)}/update` : '/admin/training-offers' %>">
        <section class="admin-editor-section">
          <h3>Основное</h3>
          <% if (!editingId) { %>
          <label>ID (латиница, для URL)</label>
          <input type="text" name="manual_id" placeholder="например winter-manual-laitse" pattern="[a-z0-9\-]*" />
          <p class="form-hint">Если пусто — сгенерируется из курса и ключа варианта.</p>
          <% } %>

          <div class="admin-editor-grid admin-editor-grid--two">
            <label>Тип курса *
              <select name="course_id" required>
                <option value="">— выберите —</option>
                <% trainingCourseOptions.forEach((opt) => { %>
                  <option value="<%= opt.id %>" <%= editingCourseId === opt.id ? "selected" : "" %>><%= opt.label %></option>
                <% }) %>
              </select>
            </label>
            <label>Ключ варианта
              <input type="text" name="variant_key" value="<%= editingVariantKey || "" %>" placeholder="manual / automatic / simulator" />
            </label>
          </div>

          <div class="admin-editor-grid admin-editor-grid--two">
            <label>Порядок сортировки
              <input type="number" name="sort_order" value="<%= typeof editingSortOrder === 'number' ? editingSortOrder : 0 %>" />
            </label>
            <label class="check-label">
              <input type="checkbox" name="is_active" value="1" <%= editingActive !== false ? "checked" : "" %> />
              <span>Активно на сайте</span>
            </label>
          </div>
        </section>

        <section class="admin-editor-section">
        <h3 class="inst-admin-sub">Параметры карточки</h3>
        <label>Картинка (путь от /images/…)</label>
        <input id="trainingOfferImage" type="text" name="image" value="<%= editingOffer ? editingOffer.image : '' %>" placeholder="/images/training/winter-placeholder.svg" />
        <%- include("../partials/admin-image-upload", {
          targetInputId: "trainingOfferImage",
          uploadHint: "Загрузить изображение карточки с устройства:"
        }) %>

        <div class="form-grid-two">
          <div>
            <label>Цена (как текст)</label>
            <input type="text" name="priceDisplay" value="<%= editingOffer ? editingOffer.priceDisplay : '' %>" placeholder="120,00 €" />
          </div>
          <div>
            <label>Число для сортировки по цене (необязательно)</label>
            <input type="number" name="sortPriceNumber" step="0.01" value="<%= editingOffer ? editingOffer.sortPriceNumber : '' %>" />
          </div>
        </div>

        <div class="form-grid-three">
          <div>
            <label>Плашка места на превью</label>
            <input type="text" name="locationBadge" value="<%= editingOffer ? editingOffer.locationBadge : '' %>" />
          </div>
          <div>
            <label>Доп. плашка (+транспорт …)</label>
            <input type="text" name="badgeExtra" value="<%= editingOffer ? editingOffer.badgeExtra : '' %>" />
          </div>
          <div>
            <label>Время урока (текст)</label>
            <input type="text" name="timeDisplay" value="<%= editingOffer ? editingOffer.timeDisplay : '' %>" />
          </div>
        </div>

        <div class="form-grid-two">
          <div>
            <label>Свободных мест (число или пусто)</label>
            <input type="number" name="seats" min="0" step="1" value="<%= editingOffer ? editingOffer.seats : '' %>" />
          </div>
          <div>
            <label class="check-label">
              <input type="checkbox" name="transportIncluded" value="1" <%= editingOffer && editingOffer.transportIncluded ? "checked" : "" %> />
              <span>Транспорт включён (галочка на карточке)</span>
            </label>
          </div>
        </div>

        </section>

        <section class="admin-editor-section">
        <h3 class="inst-admin-sub">Тексты ET / RU / EN</h3>
        <% ["et", "ru", "en"].forEach(function (lng) { %>
          <details class="admin-language-section" <%= lng === 'et' ? 'open' : '' %>>
          <summary><%= lng.toUpperCase() %> <span>Перевод карточки</span></summary>
          <div class="admin-language-fields">
          <label>Заголовок карточки <%= lng %></label>
          <input type="text" name="title_<%= lng %>" value="<%= editingOffer ? editingOffer['title_' + lng] : '' %>" />

          <label>Подзаголовок / категория <%= lng %></label>
          <input type="text" name="eyebrow_<%= lng %>" value="<%= editingOffer ? editingOffer['eyebrow_' + lng] : '' %>" />

          <label>Место / адрес <%= lng %></label>
          <input type="text" name="location_<%= lng %>" value="<%= editingOffer ? editingOffer['location_' + lng] : '' %>" />

          <label>Дата (как показывать: «Через 2 дн. …») <%= lng %></label>
          <input type="text" name="date_display_<%= lng %>" value="<%= editingOffer ? editingOffer['date_display_' + lng] : '' %>" />

          <label>Коробка / тип <%= lng %></label>
          <input type="text" name="transmission_<%= lng %>" value="<%= editingOffer ? editingOffer['transmission_' + lng] : '' %>" />

          <label>Язык группы <%= lng %></label>
          <input type="text" name="language_<%= lng %>" value="<%= editingOffer ? editingOffer['language_' + lng] : '' %>" />

          <label>HTML модалки «Доп. инфо» <%= lng %></label>
          <textarea name="modal_<%= lng %>" rows="4"><%= editingOffer ? editingOffer['modal_' + lng] : '' %></textarea>
          </div>
          </details>
        <% }); %>
        </section>

        <div class="hero-actions admin-editor-actions">
          <button class="btn" type="submit"><%= editingId ? "Сохранить" : "Добавить" %></button>
          <% if (editingId) { %>
            <a class="btn secondary" href="/admin/training-offers">Отмена</a>
          <% } %>
        </div>
      </form>
    </div>

    <div class="card admin-list-card">
      <h2>Список</h2>
      <div class="table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Курс</th>
              <th>Заголовок</th>
              <th>Порядок</th>
              <th>Активен</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% offers.forEach((o) => { %>
              <tr>
                <td><code><%= o.id %></code></td>
                <td><%= o.course_id %></td>
                <td><%= o.summaryTitle %></td>
                <td><%= o.sort_order %></td>
                <td><%= o.is_active ? "да" : "нет" %></td>
                <td class="admin-actions">
                  <a class="btn secondary small" href="/admin/training-offers/<%= encodeURIComponent(o.id) %>/edit">Изменить</a>
                  <form method="POST" action="/admin/training-offers/<%= encodeURIComponent(o.id) %>/delete" onsubmit="return confirm('Удалить запись?');">
                    <button type="submit" class="btn danger small">Удалить</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
</div>

<%- include("../partials/admin-footer") %>
