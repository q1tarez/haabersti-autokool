<%- include("../partials/header", { title }) %>

<section>
  <h1>Управление курсами</h1>
  <p class="section-lead">Добавление, редактирование, скрытие и удаление курсов со всеми деталями.</p>
  <%- include("./_nav") %>

  <div class="registration-layout">
    <div class="card">
      <h2><%= editingCourse ? "Редактировать курс" : "Добавить новый курс" %></h2>
      <form class="form" method="POST" action="<%= editingCourse ? `/admin/courses/${editingCourse.id}/update` : '/admin/courses' %>">
    <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><% } %>
        <% if (!editingCourse) { %>
          <label>ID курса (латиница, уникальный)</label>
          <input name="id" type="text" placeholder="например: b-premium" />
        <% } %>

        <label>Название (EST)</label>
        <input name="name_et" type="text" value="<%= editingCourse?.name_et || '' %>" required />
        <label>Название (RU)</label>
        <input name="name_ru" type="text" value="<%= editingCourse?.name_ru || '' %>" required />
        <label>Название (EN)</label>
        <input name="name_en" type="text" value="<%= editingCourse?.name_en || '' %>" required />

        <label>Описание (EST)</label>
        <textarea name="description_et" rows="2"><%= editingCourse?.description_et || '' %></textarea>
        <label>Описание (RU)</label>
        <textarea name="description_ru" rows="2"><%= editingCourse?.description_ru || '' %></textarea>
        <label>Описание (EN)</label>
        <textarea name="description_en" rows="2"><%= editingCourse?.description_en || '' %></textarea>

        <label>Цена</label>
        <input name="price" type="text" value="<%= editingCourse?.price || '' %>" required />

        <label>Длительность (EST)</label>
        <input name="duration_et" type="text" value="<%= editingCourse?.duration_et || '' %>" />
        <label>Длительность (RU)</label>
        <input name="duration_ru" type="text" value="<%= editingCourse?.duration_ru || '' %>" />
        <label>Длительность (EN)</label>
        <input name="duration_en" type="text" value="<%= editingCourse?.duration_en || '' %>" />

        <label class="check-label">
          <input type="checkbox" name="is_active" value="1" <%= !editingCourse || editingCourse.is_active ? "checked" : "" %> />
          <span>Показывать на сайте</span>
        </label>

        <div class="hero-actions">
          <button class="btn" type="submit"><%= editingCourse ? "Сохранить изменения" : "Добавить курс" %></button>
          <% if (editingCourse) { %>
            <a class="btn secondary" href="/admin/courses">Отмена</a>
          <% } %>
        </div>
      </form>
    </div>

    <div class="card">
      <h2>Список курсов</h2>
      <div class="table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Название RU</th>
              <th>Цена</th>
              <th>Статус</th>
              <th>Действия</th>
            </tr>
          </thead>
          <tbody>
            <% courses.forEach((course) => { %>
              <tr>
                <td><%= course.id %></td>
                <td><%= course.name_ru %></td>
                <td><%= course.price %></td>
                <td><%= course.is_active ? "Активен" : "Скрыт" %></td>
                <td class="table-actions">
                  <a class="btn secondary" href="/admin/courses/<%= course.id %>/edit">Изменить</a>
                  <form method="POST" action="/admin/courses/<%= course.id %>/delete" onsubmit="return confirm('Удалить курс?');">
    <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><% } %>
                    <button class="btn danger" type="submit">Удалить</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<%- include("../partials/footer") %>
