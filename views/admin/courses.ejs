<%- include("../partials/admin-header", { title }) %>

<header class="admin-page-header">
  <h1>Управление курсами</h1>
  <p class="section-lead">Добавление, редактирование, скрытие и удаление курсов со всеми деталями.</p>
</header>

<div class="registration-layout admin-split-layout admin-management-layout">
    <div class="card admin-editor-card">
      <h2><%= editingCourse ? "Редактировать курс" : "Добавить новый курс" %></h2>
      <p class="admin-editor-hint">Сначала заполните основные данные, затем добавьте названия и описания на доступных языках.</p>
      <form class="form" method="POST" action="<%= editingCourse ? `/admin/courses/${editingCourse.id}/update` : '/admin/courses' %>">
        <section class="admin-editor-section">
          <h3>Основное</h3>
          <% if (!editingCourse) { %>
            <label>ID курса (латиница, уникальный)</label>
            <input name="id" type="text" placeholder="например: b-premium" />
          <% } %>
          <div class="admin-editor-grid admin-editor-grid--three">
            <label>Название (EST)
              <input name="name_et" type="text" value="<%= editingCourse?.name_et || '' %>" required />
            </label>
            <label>Название (RU)
              <input name="name_ru" type="text" value="<%= editingCourse?.name_ru || '' %>" required />
            </label>
            <label>Название (EN)
              <input name="name_en" type="text" value="<%= editingCourse?.name_en || '' %>" required />
            </label>
          </div>
        </section>

        <section class="admin-editor-section">
          <h3>Описание на каждом языке</h3>
          <div class="admin-editor-grid admin-editor-grid--three">
            <label>Описание (EST)
              <textarea name="description_et" rows="4"><%= editingCourse?.description_et || '' %></textarea>
            </label>
            <label>Описание (RU)
              <textarea name="description_ru" rows="4"><%= editingCourse?.description_ru || '' %></textarea>
            </label>
            <label>Описание (EN)
              <textarea name="description_en" rows="4"><%= editingCourse?.description_en || '' %></textarea>
            </label>
          </div>
        </section>

        <section class="admin-editor-section">
          <h3>Стоимость и длительность</h3>
          <label>Цена
            <input name="price" type="text" value="<%= editingCourse?.price || '' %>" required placeholder="Например: 490 €" />
          </label>
          <div class="admin-editor-grid admin-editor-grid--three">
            <label>Длительность (EST)
              <input name="duration_et" type="text" value="<%= editingCourse?.duration_et || '' %>" />
            </label>
            <label>Длительность (RU)
              <input name="duration_ru" type="text" value="<%= editingCourse?.duration_ru || '' %>" />
            </label>
            <label>Длительность (EN)
              <input name="duration_en" type="text" value="<%= editingCourse?.duration_en || '' %>" />
            </label>
          </div>
        </section>

        <label class="check-label admin-editor-active">
          <input type="checkbox" name="is_active" value="1" <%= !editingCourse || editingCourse.is_active ? "checked" : "" %> />
          <span>Показывать на сайте</span>
        </label>

        <div class="hero-actions admin-editor-actions">
          <button class="btn" type="submit"><%= editingCourse ? "Сохранить изменения" : "Добавить курс" %></button>
          <% if (editingCourse) { %>
            <a class="btn secondary" href="/admin/courses">Отмена</a>
          <% } %>
        </div>
      </form>
    </div>

    <div class="card admin-list-card">
      <h2>Список курсов</h2>
      <div class="table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Название RU</th>
              <th>Цена</th>
              <th>Статус</th>
              <th>Действия</th>
            </tr>
          </thead>
          <tbody>
            <% courses.forEach((course) => { %>
              <tr>
                <td><%= course.id %></td>
                <td><%= course.name_ru %></td>
                <td><%= course.price %></td>
                <td><%= course.is_active ? "Активен" : "Скрыт" %></td>
                <td class="table-actions">
                  <a class="btn secondary" href="/admin/courses/<%= course.id %>/preview" target="_blank" rel="noopener">Превью</a>
                  <a class="btn secondary" href="/admin/courses/<%= course.id %>/edit">Изменить</a>
                  <form method="POST" action="/admin/courses/<%= course.id %>/delete" onsubmit="return confirm('Удалить курс?');">
                    <button class="btn danger" type="submit">Удалить</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
</div>

<%- include("../partials/admin-footer") %>
