<%- include("../partials/admin-header", { title, adminLogin: true }) %>

<section class="card auth-box admin-auth-box">
  <h1><%= adminT("passwordRecoveryTitle") %></h1>
  <p><%= adminT("passwordRecoveryLead") %></p>
  <% if (error) { %><p class="alert error"><%= error %></p><% } %>
  <% if (notice) { %><p class="admin-alert admin-alert--ok"><%= notice %></p><% } %>
  <form class="form" method="POST" action="/admin/password/forgot">
    <label for="email"><%= adminT("settingsEmailInput") %></label>
    <input id="email" name="email" type="email" maxlength="200" autocomplete="email" required />
    <button class="btn" type="submit"><%= adminT("passwordRecoverySend") %></button>
  </form>
  <p><a href="/admin/login"><%= adminT("signIn") %></a></p>
</section>

<%- include("../partials/admin-footer", { adminLogin: true }) %>
