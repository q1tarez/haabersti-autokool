<%- include("../partials/header", { title }) %>

<section>
  <h1>Обращения с сайта</h1>
  <p class="section-lead">Все сообщения из формы контактов и управление статусом обработки.</p>
  <%- include("./_nav") %>

  <div class="card table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Дата</th>
          <th>Имя</th>
          <th>Телефон</th>
          <th>Сообщение</th>
          <th>Статус</th>
          <th>Действия</th>
        </tr>
      </thead>
      <tbody>
        <% contacts.forEach((item) => { %>
          <tr>
            <td><%= item.created_at %></td>
            <td><%= item.full_name %></td>
            <td><%= item.phone %></td>
            <td><%= item.message || "-" %></td>
            <td><%= item.status || "new" %></td>
            <td class="table-actions">
              <form method="POST" action="/admin/contacts/<%= item.id %>/status" class="inline-form">
                <select name="status">
                  <option value="new" <%= (item.status || "new") === "new" ? "selected" : "" %>>Новая</option>
                  <option value="in_progress" <%= item.status === "in_progress" ? "selected" : "" %>>В работе</option>
                  <option value="done" <%= item.status === "done" ? "selected" : "" %>>Закрыта</option>
                </select>
                <button class="btn secondary" type="submit">OK</button>
              </form>
              <form method="POST" action="/admin/contacts/<%= item.id %>/delete" onsubmit="return confirm('Удалить обращение?');">
                <button class="btn danger" type="submit">Удалить</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<%- include("../partials/footer") %>
