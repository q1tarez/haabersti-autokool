<%- include("../partials/admin-header", { title }) %>

<header class="admin-page-header">
  <h1><%= t("dashboardHello") %>, <%= username %>!</h1>
  <p class="section-lead">Курсы, ученики, обращения, статусы и быстрые действия.</p>
</header>

<div class="stats admin-stats">
  <article>
    <p class="number"><%= stats.coursesCount %></p>
    <p>Активных курсов</p>
  </article>
  <article>
    <p class="number"><%= stats.studentsCount %></p>
    <p>Всего записей учеников</p>
  </article>
  <article>
    <p class="number"><%= stats.contactsCount %></p>
    <p>Всего обращений</p>
  </article>
  <article>
    <p class="number"><%= stats.newLeadsCount %></p>
    <p>Новых заявок</p>
  </article>
</div>

<%- include("../partials/admin-footer") %>
