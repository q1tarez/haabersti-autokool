<%- include("../partials/admin-header", { title, adminLogin: true }) %>

<section class="card auth-box admin-auth-box">
  <h1><%= adminT("passwordResetTitle") %></h1>
  <% if (invalid) { %>
    <p class="alert error"><%= adminT("passwordResetInvalid") %></p>
  <% } else { %>
    <% if (error) { %><p class="alert error"><%= error %></p><% } %>
    <form class="form" method="POST" action="/admin/password/reset/<%= token %>">
      <label for="password"><%= adminT("settingsNewPassword") %></label>
      <input id="password" name="password" type="password" minlength="12" maxlength="72" autocomplete="new-password" required />
      <label for="confirmPassword"><%= adminT("settingsConfirmPassword") %></label>
      <input id="confirmPassword" name="confirmPassword" type="password" minlength="12" maxlength="72" autocomplete="new-password" required />
      <button class="btn" type="submit"><%= adminT("settingsSavePassword") %></button>
    </form>
  <% } %>
</section>

<%- include("../partials/admin-footer", { adminLogin: true }) %>
