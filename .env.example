SESSION_SECRET=change-me-please

# Neon — только в Vercel / локальный .env (не коммить пароли).
# На Vercel после подключения Postgres часто есть POSTGRES_URL — приложение подхватит его само.
# Или задайте явно одну строку:
DATABASE_URL=postgresql://neondb_owner:npg_10cDIhBXigkb@ep-hidden-sky-aq19hm3d-pooler.c-8.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require
# STORAGE_URL=
# DB_INIT_ATTEMPTS=6   (повторы при временном сбое Neon на холодном старте Vercel, по умолчанию 6)

# --- Gmail на Vercel (письма при оплате «банковский перевод») ---
#
# 1) Google Account → Security → 2-Step Verification → App passwords.
#    Создайте пароль приложения для «Mail», скопируйте 16 символов.
# 2) Vercel → проект → Settings → Environment Variables → добавьте для Production:
#
#    SMTP_USE_GMAIL=1
#    SMTP_USER=ваш@gmail.com
#    SMTP_PASS=xxxxxxxxxxxxxxxx    (16 символов пароля приложения, пробелы можно убрать)
#    MAIL_FROM="Haabersti Autokool <ваш@gmail.com>"
#
# 3) Save → Redeploy.
#
# Локально тот же набор в файле .env (не добавляйте .env в git).
#
# Альтернатива без SMTP_USE_GMAIL: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_SECURE=0 + те же USER/PASS.

SMTP_USE_GMAIL=
SMTP_USER=qonetarez@gmail.com
SMTP_PASS=syxd ciyf snbz gezh
MAIL_FROM=qonetarez@gmail.com

# --- Реквизиты для письма «банковский перевод» (обязательно для отправки) ---
