PORT=3000
# Required for signed admin cookies (use a long random string in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Database (Neon / Postgres on Vercel). Do NOT commit real credentials.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# POSTGRES_URL=
# DB_INIT_ATTEMPTS=6

# Public site URL (sitemap, emails, OG)
# PUBLIC_SITE_URL=https://your-domain.example

# --- Gmail / SMTP ---
# SMTP_USE_GMAIL=1
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=noreply@your-domain.example

# --- Bank transfer email to students ---
# BANK_BENEFICIARY_NAME=
# BANK_IBAN=
# SCHOOL_CONTACT_PHONE=
# SCHOOL_CONTACT_EMAIL=

# --- Notify school on new leads ---
# ADMIN_NOTIFY_EMAIL=office@your-domain.example
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Error monitoring (optional webhook, e.g. Slack) ---
# ERROR_WEBHOOK_URL=

# --- Analytics & messengers ---
# GA_MEASUREMENT_ID=G-XXXXXXXX
# WHATSAPP_PHONE=37256847904
# TELEGRAM_PUBLIC_URL=https://t.me/your_channel

# Neon backups: enable automatic backups in Neon dashboard (Settings → Backups).
